{
  "$comment": "Par display+texto — Google Fonts. Substitua se a marca oficial usar outro par.",
  "display": {
    "family": "Cormorant Garamond",
    "google_fonts_url": "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap",
    "weights": [400, 500, 600, 700],
    "tracking": "-0.01em",
    "use": "Headlines (h1, h2), eyebrows épicos, citações do hino"
  },
  "text": {
    "family": "Inter",
    "google_fonts_url": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap",
    "weights": [400, 500, 600, 700],
    "tracking": "0",
    "use": "Corpo de texto, UI, navegação, CTAs"
  },
  "scale_rem": {
    "xs":   0.75,
    "sm":   0.875,
    "base": 1,
    "lg":   1.125,
    "xl":   1.5,
    "2xl":  2,
    "3xl":  2.75,
    "4xl":  3.75,
    "5xl":  5
  },
  "line_heights": {
    "tight":   1.1,
    "snug":    1.25,
    "normal":  1.5,
    "relaxed": 1.7
  }
}
