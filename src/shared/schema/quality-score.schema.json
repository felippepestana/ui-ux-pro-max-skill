{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/felippepestana/ui-ux-pro-max-skill/blob/main/src/shared/schema/quality-score.schema.json",
  "title": "Quality score (A-F across 7 categories)",
  "description": "Output of design-md quality scorer.",
  "type": "object",
  "properties": {
    "overall_grade": { "type": "string", "enum": ["A", "B", "C", "D", "F"] },
    "overall_score": { "type": "number" },
    "categories":    { "type": "object" }
  },
  "additionalProperties": true
}
