{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/felippepestana/ui-ux-pro-max-skill/blob/main/src/shared/schema/tokens.schema.json",
  "title": "DESIGN.md tokens",
  "description": "Canonical shape of tokens.json produced by design-md (parsed YAML frontmatter from DESIGN.md).",
  "type": "object",
  "properties": {
    "color":      { "type": "object" },
    "typography": { "type": "object" },
