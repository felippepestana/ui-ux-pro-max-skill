# ============================================
# UI/UX Pro Max Editor - Configuração Produção
# ============================================

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=your-super-secret-key-change-this-in-production

# Server Configuration
PORT=5000
WORKERS=4
WORKER_CLASS=sync
WORKER_TIMEOUT=120

# Domain Configuration
DOMAIN=seu-dominio.com
ALLOWED_ORIGINS=https://seu-dominio.com

# SSL Configuration
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Logging
LOG_LEVEL=info
LOG_FILE=/app/logs/app.log

# Docker
COMPOSE_PROJECT_NAME=ui-ux-pro-max

# ============================================
# design-md (companion skill)
# ============================================

# When set, every successful design-md extraction appends a row to
# src/ui-ux-pro-max/data/extracted-references.csv via src/shared/cli/uipro-bridge.cjs
DESIGN_MD_POST_HOOK=./scripts/design-md-post-hook.cjs

# Override outputs root (default: outputs/design-md/{slug}/ relative to CWD)
# DESIGN_MD_OUTPUTS_DIR=

# Set to 1 to bypass the post-hook for a single run
# DESIGN_MD_SKIP_HOOK=1

# OpenRouter provider for design-md (alternative to claude-cli)
# OPENROUTER_API_KEY=

# ============================================
# Instagram media collector (content/destemidos-pioneiros/media/)
# ============================================

# Session cookie used by scripts/collect-instagram.cjs to authenticate against
# Instagram's web profile endpoint. Get it from a logged-in browser session
# (cookie name: sessionid). Required only when running automated media pulls.
# INSTAGRAM_SESSION_ID=
